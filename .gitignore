lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
installer_output/
*.zip

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Security, Private Keys & Credentials (NEVER COMMIT PRIVATE KEYS)
*.pfx
*.p12
*.key
*.pem
*.secret
*.cer
.env
.env.*
!.env.example

# Code Signing Private Certificates & Local Key Tooling (Never commit to public repos)
Prince_Sanchela.pfx
Prince_Sanchela.cer
create_certificate.ps1
sign_binaries.ps1
Sign_Inno_Setup.bat
Trust_Prince_Sanchela.bat
scripts/sign_binaries.ps1
scripts/Sign_Inno_Setup.bat
scripts/Trust_Prince_Sanchela.bat

